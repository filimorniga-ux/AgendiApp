{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/empleo/(?<id>[a-zA-Z0-9-]+)",
      "destination": "/api/job?id=$id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
